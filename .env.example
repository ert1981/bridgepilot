# ---- Server
PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=https://your-domain.example

# live = real LI.FI/Across APIs; simulated = offline synthetic quotes (labelled, never executable)
PROVIDER_MODE=live
ENABLED_PROVIDERS=lifi,across

# ---- Providers
LIFI_BASE_URL=https://li.quest/v1/
LIFI_API_KEY=
LIFI_INTEGRATOR=bridgepilot
ACROSS_BASE_URL=https://app.across.to/api/
ACROSS_API_KEY=
# Keep false until depositV3 calldata is verified on a testnet against the current SpokePool.
ACROSS_EXECUTION_ENABLED=false

# Optional RPC overrides (used for gas price + allowance reads)
# RPC_URL_ETHEREUM= RPC_URL_BASE= RPC_URL_ARBITRUM= RPC_URL_OPTIMISM= RPC_URL_POLYGON=

# ---- Request budget
PROVIDER_TIMEOUT_MS=6000
PROVIDER_RETRIES=1
REQUEST_BUDGET_MS=12000
QUOTE_TTL_MS=60000
QUOTE_CACHE_TTL_MS=10000

# ---- Hard safety caps (users can only tighten)
HARD_MAX_SLIPPAGE_BPS=300
DEFAULT_SLIPPAGE_BPS=50
HARD_MAX_VALUE_LOSS_BPS=500
TIE_TOLERANCE_BPS=1
ALLOW_STABLE_PEG_FALLBACK=true
# Comma-separated provider/bridge ids with critical security alerts
SECURITY_DENYLIST=

# ---- Access
API_KEYS=
ADMIN_KEYS=
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SEC=0.5

# ---- x402 payments (off | facilitator)
X402_MODE=off
X402_FACILITATOR_URL=https://x402.org/facilitator/
X402_NETWORK=base
X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_PAY_TO=
# 10000 = 0.01 USDC (6 decimals)
X402_PRICE_ATOMIC=10000

AUDIT_LOG_PATH=./audit.log
STORAGE_PATH=./data/bridgepilot.sqlite
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000
APPROVAL_GAS_UNITS=55000
